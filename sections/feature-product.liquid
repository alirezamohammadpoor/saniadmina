{%- comment -%}
  Feature Product
  ----------------------------------------------------------------------------
  Editorial 50/50 section for highlighting a product or collection with
  brand-story copy. Image on one side, heading + body paragraph on the other.
  Bottom-inner-corner anchored on desktop, stacked on mobile.

  Designed in Figma — see Components / Editorial → Feature Product.
{%- endcomment -%}

{%- assign image_right = false -%}
{%- if section.settings.image_position == 'right' -%}
  {%- assign image_right = true -%}
{%- endif -%}

<section class="flex flex-col lg:flex-row mt-(--spacing-layout)" data-section-id="{{ section.id }}" data-section-type="feature-product">
  {%- comment -%} Image — first on mobile (source order), reorder via lg:order on desktop {%- endcomment -%}
  <div class="w-full aspect-[3/4] lg:aspect-auto lg:w-1/2 {% if image_right %}lg:order-2{% endif %}">
    {% if section.settings.image %}
      {{ section.settings.image
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          class: 'w-full h-full object-cover',
          sizes: '(max-width: 1023px) 100vw, 50vw',
          alt: section.settings.heading | default: ''
      }}
    {% else %}
      <div class="w-full h-full bg-[#E8E5E0]"></div>
    {% endif %}
  </div>

  {%- comment -%} Content — top-aligned/left on mobile, bottom-inner-corner on desktop {%- endcomment -%}
  <div class="w-full lg:w-1/2 px-2 py-(--spacing-layout) lg:px-6 lg:flex lg:flex-col {% if image_right %}lg:order-1{% endif %}">
    <div class="lg:mt-auto flex flex-col gap-2 {% if image_right %}lg:text-right{% endif %}">
      {% if section.settings.heading != blank %}
        <h2 class="text-h3 lg:text-[16px]">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="text-[12px]">{{ section.settings.body }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Product",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Renders as an H2. Example: \"Spring Edit 2026\"."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy"
    }
  ],
  "presets": [
    {
      "name": "Feature Product"
    }
  ]
}
{% endschema %}
