{% doc %}
  Product Scroll
  ------------------------------------------------------------------------------
  Horizontal scrolling product card strip. Composes scroll-strip with
  product-card content. Used for "You may also like" (PDP related products)
  and "New Arrivals" (homepage featured products).

  @param {object} products - Collection of products to display - required
  @param {string} [title] - Optional heading text
  @param {number} [limit] - Maximum products to show - defaults to 6
  @param {object} [collection] - Optional collection context forwarded to each product-card

  @example
    {% render 'product-scroll',
               products: collection.products,
               title: 'You may also like',
               limit: 6
    %}
{% enddoc %}

{%- liquid
  if limit == blank
    assign limit = 6
  endif

  assign scroll_label = title | default: 'products.product.scroll_default_label' | t
-%}

{%- capture items -%}
  {%- for product in products limit: limit -%}
    <div class="scroll-strip-item">
      {% render 'product-card',
                product: product,
                collection: collection,
                sizes: '(max-width: 1023.98px) 70vw, 25vw' %}
    </div>
  {%- endfor -%}
{%- endcapture -%}

{% render 'scroll-strip',
          title: title,
          aria_label: scroll_label,
          items: items %}
